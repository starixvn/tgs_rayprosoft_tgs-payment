<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="raypro-baget" value="https://baget.rpgp.cc/v3/index.json" />
		<add key="s1-baget" value="https://baget.nexentgame.com/v3/index.json" />
	</packageSources>
	<config>
		<add key="signatureValidationMode" value="accept" />
	</config>
	<packageSourceMapping>
		<!-- key value for <packageSource> should match key values from <packageSources> element -->
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
		<packageSource key="raypro-baget">
			<package pattern="Tgs.*" />
			<package pattern="PagingUtility.*" />
		</packageSource>
		<packageSource key="s1-baget">
			<package pattern="Payment.*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
