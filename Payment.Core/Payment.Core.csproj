		<RootNamespace>Tgs.Payment</RootNamespace>
		<Nullable>enable</Nullable>
		<PackageId>Tgs.Payment.Core</PackageId>
		<Product>Tgs.Payment.Core</Product>
		<Authors>Raypro</Authors>
		<Version>0.0.8-alpha</Version>
