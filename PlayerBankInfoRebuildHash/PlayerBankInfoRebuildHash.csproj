	<ItemGroup>
		<ProjectReference Include="..\PaymentRepositories\PaymentRepositories.csproj" />
		<ProjectReference Include="..\Tgs.Payment.Client\Tgs.Payment.Client.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
