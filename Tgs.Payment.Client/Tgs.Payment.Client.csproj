<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
		<Version>0.6.11</Version>
		<Authors>Raypro</Authors>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-payment</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-payment.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>tgs payment</PackageTags>
		<PackageId>Tgs.Payment.Client</PackageId>
		<Product>Tgs.Payment.Client</Product>
		<RootNamespace>Tgs.Payment.Clients</RootNamespace>
		<AssemblyName>Tgs.Payment.Client</AssemblyName>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>10.0</LangVersion>
		<SqlQueryToolsConnectionString />
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Protos\payment.proto" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.26.1" />
		<PackageReference Include="Grpc.Tools" Version="2.63.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
		<PackageReference Include="NATS.Net" Version="2.3.3" />
		<PackageReference Include="PhoenixToolkits.MessageQueue" Version="2.2.0" />
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.7" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Protos\payment.proto" GrpcServices="None" Access="Public" />
	</ItemGroup>

</Project>
